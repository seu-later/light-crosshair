<Page x:Class="LightCrosshairGameBar.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="16" Spacing="10"><TextBlock Text="LightCrosshair — Game Bar"/><Button Content="Load PNG" Click="LoadImage_Click"/><TextBlock x:Name="ImageName" Text="No image selected"/><CheckBox x:Name="TintEnabled" Content="Tint" Checked="Changed" Unchecked="Changed"/><TextBox x:Name="Tint" Header="Tint hex (#RRGGBB)" TextChanged="Changed"/><TextBox x:Name="ScaleBox" Header="Scale (0.00–5.00)" TextChanged="Changed"/><TextBox x:Name="OpacityBox" Header="Opacity (0–100)" TextChanged="Changed"/><TextBox x:Name="OffsetX" Header="X offset (-100–100 px)" TextChanged="Changed"/><TextBox x:Name="OffsetY" Header="Y offset (-100–100 px)" TextChanged="Changed"/><TextBox x:Name="CenterHotkey" Header="Center hotkey" TextChanged="Changed"/><TextBox x:Name="HideHotkey" Header="Hide hotkey" TextChanged="Changed"/><TextBox x:Name="ShowHotkey" Header="Show hotkey" TextChanged="Changed"/><TextBlock Text="Use Game Bar's pin button after centering. Hotkeys accept Ctrl+Alt+C, F1, Left Click, Mouse 4, and similar Windows key names." TextWrapping="Wrap"/></StackPanel></ScrollViewer>
</Page>
